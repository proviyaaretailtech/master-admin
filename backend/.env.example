PORT=8000
NODE_ENV=development
BASE_PATH=/api
# Browser origins allowed to call the API cross-origin (comma separated, exact match, no wildcards).
# The API's own origin (the normal single-deployment setup) needs no entry.
CLIENT_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of the app (Vercel = 1, direct = 0). Needed for correct per-IP rate limiting.
TRUST_PROXY=0

# Supabase Credentials (obtain from Supabase dashboard: Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL URL for terminal migrations (Project Settings -> Database -> Connection String URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Server-side only: creates platform staff accounts. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Database TLS (hosted database): the certificate is verified. Provide the CA to trust (Supabase publishes
# its root CA for download), as PEM text or a file path. Production refuses to start without one of these.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=
# Explicit, logged opt-out (NOT recommended): DATABASE_SSL_REJECT_UNAUTHORIZED=false
