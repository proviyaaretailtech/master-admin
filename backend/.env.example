PORT=8000
NODE_ENV=development
BASE_PATH=/api
# Browser origins allowed to call the API cross-origin (comma separated, exact match, no wildcards).
# The API's own origin (the normal single-deployment setup) needs no entry.
CLIENT_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of the app (Vercel = 1, direct = 0). Needed for correct per-IP rate limiting.
TRUST_PROXY=0

# Supabase Credentials (obtain from Supabase dashboard: Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL URL for terminal migrations (Project Settings -> Database -> Connection String URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Server-side only: creates platform staff accounts. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Database TLS (hosted database): the certificate is verified. Provide the CA to trust (Supabase publishes
# its root CA for download), as PEM text or a file path. Production refuses to start without one of these.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=
# Explicit, logged opt-out (NOT recommended): DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Master immediate build. Names only; set real values in the deployment, never commit them.
# One Local dispatch API (server to server, signed per RIDER_DISPATCH_API.md section 2). If any is missing, dispatch actions answer 503 provider_not_configured.
# DISPATCH_API_URL=
# DISPATCH_SERVICE_TOKEN=
# DISPATCH_SIGNING_SECRET=
# One Local backend origin (e.g. http://localhost:8100 locally). Held-order release/reject is sent to its admin API
# (/api/admin/order-holds/:id) with the signed-in staff member's own session; One Local accepts super admins only.
# If missing, those two actions answer 503 provider_not_configured (the held-orders list still works).
# ONE_LOCAL_API_URL=
# Label shown as the environment badge (local, staging, production); defaults from NODE_ENV.
# APP_ENV=
# Raises the global per-IP request ceiling (default 200 per 15 min); the test script sets it.
# GLOBAL_RATE_LIMIT_MAX=
